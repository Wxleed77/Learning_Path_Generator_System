{
  "goalTitle": "Learn DevOps",
  "skillLevel": "beginner",
  "aliases": ["devops", "dev ops", "learn devops", "devops engineer", "devops engineering"],
  "roadmap": {
    "totalWeeks": 6,
    "weeks": [
      {
        "weekNumber": 1,
        "theme": "Linux and Networking Basics",
        "estimatedHours": 10,
        "difficulty": "beginner",
        "topics": [
          {
            "title": "The Linux command line",
            "description": "Files, permissions, processes, packages, and shell scripting basics.",
            "estimatedHours": 3
          },
          {
            "title": "Networking fundamentals",
            "description": "IP addressing, DNS, ports, TCP vs UDP, and troubleshooting with curl and dig.",
            "estimatedHours": 3
          },
          {
            "title": "SSH and remote servers",
            "description": "Keys, SSH config, copying files, and running commands on a remote host.",
            "estimatedHours": 2
          }
        ],
        "resources": [
          {
            "title": "Linux Journey",
            "type": "course",
            "url": "https://linuxjourney.com/",
            "estimatedMinutes": 120
          },
          {
            "title": "MDN: How the web works",
            "type": "article",
            "url": "https://developer.mozilla.org/en-US/docs/Learn/Common_questions/Web_mechanics/How_does_the_Internet_work",
            "estimatedMinutes": 45
          },
          {
            "title": "SSH Academy",
            "type": "course",
            "url": "https://www.ssh.com/academy/ssh",
            "estimatedMinutes": 60
          }
        ],
        "projects": [
          {
            "title": "Provision a Linux VM",
            "description": "Create a cloud VM, connect over SSH, install a web server, and serve a static page.",
            "difficulty": "beginner"
          }
        ],
        "quiz": {
          "questionCount": 3,
          "topicsCovered": ["Linux CLI", "Networking", "SSH"],
          "passingScore": 70
        },
        "milestone": "Serve a page from a remote Linux server you configured yourself."
      },
      {
        "weekNumber": 2,
        "theme": "Git Workflows and CI/CD",
        "estimatedHours": 10,
        "difficulty": "beginner",
        "topics": [
          {
            "title": "Branching and collaboration",
            "description": "Feature branches, pull requests, merge vs rebase, and conflict resolution.",
            "estimatedHours": 2
          },
          {
            "title": "GitHub Actions",
            "description": "Workflows, jobs, steps, triggers, secrets, and caching dependencies.",
            "estimatedHours": 4
          },
          {
            "title": "Continuous delivery concepts",
            "description": "Build, test, and deploy stages with safe rollbacks.",
            "estimatedHours": 2
          }
        ],
        "resources": [
          {
            "title": "GitHub Actions quickstart",
            "type": "documentation",
            "url": "https://docs.github.com/en/actions/quickstart",
            "estimatedMinutes": 60
          },
          {
            "title": "GitHub Skills: Hello GitHub Actions",
            "type": "course",
            "url": "https://skills.github.com/",
            "estimatedMinutes": 90
          },
          {
            "title": "Pro Git: Branching",
            "type": "documentation",
            "url": "https://git-scm.com/book/en/v2/Git-Branching-Branches-in-a-Nutshell",
            "estimatedMinutes": 45
          }
        ],
        "projects": [
          {
            "title": "CI pipeline for a small app",
            "description": "Add a GitHub Actions workflow that installs, lints, tests, and builds on every push.",
            "difficulty": "beginner"
          }
        ],
        "quiz": {
          "questionCount": 3,
          "topicsCovered": ["Git branching", "GitHub Actions", "CI/CD"],
          "passingScore": 70
        },
        "milestone": "Every push runs an automated test and build pipeline."
