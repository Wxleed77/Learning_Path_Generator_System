      {
        "weekNumber": 3,
        "theme": "Containers with Docker",
        "estimatedHours": 10,
        "difficulty": "beginner",
        "topics": [
          {
            "title": "Images and containers",
            "description": "Build images, run containers, map ports, and manage data with volumes.",
