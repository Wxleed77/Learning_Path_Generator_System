        "estimatedHours": 10,
        "difficulty": "beginner",
        "topics": [
          {
            "title": "Pods, services, and deployments",
            "description": "Run workloads, expose them, and manage replicas.",
            "estimatedHours": 4
          },
          {
            "title": "Configuration and secrets",
            "description": "ConfigMaps, Secrets, and environment configuration for workloads.",
            "estimatedHours": 2
          },
          {
            "title": "Ingress and scaling",
            "description": "Route traffic, set resource limits, and scale with the horizontal pod autoscaler.",
            "estimatedHours": 2
          }
        ],
        "resources": [
          {
            "title": "Kubernetes basics tutorial",
            "type": "documentation",
            "url": "https://kubernetes.io/docs/tutorials/kubernetes-basics/",
            "estimatedMinutes": 120
          },
          {
            "title": "Kubernetes concepts",
            "type": "documentation",
            "url": "https://kubernetes.io/docs/concepts/",
            "estimatedMinutes": 90
          },
          {
            "title": "minikube tutorial",
            "type": "documentation",
            "url": "https://minikube.sigs.k8s.io/docs/start/",
            "estimatedMinutes": 45
          }
        ],
        "projects": [
          {
            "title": "Deploy the stack to Kubernetes",
            "description": "Deploy a containerized app to a local cluster with a service, ingress, and config.",
            "difficulty": "beginner"
          }
        ],
        "quiz": {
          "questionCount": 3,
          "topicsCovered": ["Pods/Services", "ConfigMaps", "Ingress"],
          "passingScore": 70
        },
        "milestone": "A workload running on a local Kubernetes cluster with external access."
      },
      {
        "weekNumber": 5,
        "theme": "Cloud and Infrastructure as Code",
        "estimatedHours": 10,
        "difficulty": "beginner",
        "topics": [
          {
            "title": "Cloud fundamentals",
            "description": "Compute, storage, networking, IAM, and the shared responsibility model.",
            "estimatedHours": 3
          },
          {
            "title": "Terraform basics",
            "description": "Providers, resources, variables, state, and plan/apply workflows.",
            "estimatedHours": 4
          },
          {
            "title": "Secrets and environments",
            "description": "Separate dev and prod configuration and keep credentials out of code.",
            "estimatedHours": 1
          }
        ],
        "resources": [
          {
            "title": "AWS Cloud Practitioner essentials",
            "type": "course",
            "url": "https://aws.amazon.com/training/digital/aws-cloud-practitioner-essentials/",
            "estimatedMinutes": 120
          },
          {
            "title": "Terraform getting started",
            "type": "documentation",
            "url": "https://developer.hashicorp.com/terraform/tutorials/aws-get-started",
            "estimatedMinutes": 120
          },
          {
            "title": "Terraform language docs",
            "type": "documentation",
            "url": "https://developer.hashicorp.com/terraform/language",
            "estimatedMinutes": 60
          }
        ],
        "projects": [
          {
            "title": "Infrastructure as code",
            "description": "Use Terraform to provision a VM and network, then tear it down cleanly.",
            "difficulty": "beginner"
          }
        ],
        "quiz": {
          "questionCount": 3,
          "topicsCovered": ["Cloud basics", "Terraform", "Secrets"],
          "passingScore": 70
        },
