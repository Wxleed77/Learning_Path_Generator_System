          },
          {
            "title": "Writing Dockerfiles",
            "description": "Layer caching, multi-stage builds, and small production images.",
            "estimatedHours": 3
          },
          {
            "title": "Compose for multi-service apps",
            "description": "Define services, networks, and environment configuration in compose.",
            "estimatedHours": 2
          }
        ],
        "resources": [
          {
            "title": "Docker get started",
            "type": "documentation",
            "url": "https://docs.docker.com/get-started/",
            "estimatedMinutes": 120
          },
          {
            "title": "Docker Compose overview",
            "type": "documentation",
            "url": "https://docs.docker.com/compose/",
            "estimatedMinutes": 60
          },
          {
            "title": "Best practices for Dockerfiles",
            "type": "article",
            "url": "https://docs.docker.com/develop/develop-images/dockerfile_best-practices/",
            "estimatedMinutes": 45
          }
        ],
        "projects": [
          {
            "title": "Containerized app stack",
            "description": "Package an API and database with Docker Compose and run the whole stack locally.",
            "difficulty": "beginner"
          }
        ],
        "quiz": {
          "questionCount": 3,
          "topicsCovered": ["Docker images", "Dockerfiles", "Compose"],
          "passingScore": 70
        },
        "milestone": "Run a reproducible multi-service stack with one command."
      },
      {
