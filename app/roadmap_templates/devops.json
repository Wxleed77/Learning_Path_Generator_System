          },
          {
            "title": "Monitoring and alerting",
            "description": "Dashboards, SLOs, and alerts that catch real problems.",
            "estimatedHours": 3
          },
          {
            "title": "Incident response basics",
            "description": "Runbooks, rollbacks, and post-incident reviews.",
            "estimatedHours": 2
          }
        ],
        "resources": [
          {
            "title": "Prometheus getting started",
            "type": "documentation",
            "url": "https://prometheus.io/docs/introduction/first_steps/",
            "estimatedMinutes": 75
          },
          {
            "title": "Grafana fundamentals",
            "type": "documentation",
            "url": "https://grafana.com/tutorials/grafana-fundamentals/",
            "estimatedMinutes": 60
          },
          {
            "title": "Google SRE book",
            "type": "documentation",
            "url": "https://sre.google/sre-book/table-of-contents/",
            "estimatedMinutes": 60
          }
        ],
        "projects": [
          {
            "title": "Capstone: end-to-end pipeline",
            "description": "Build a CI/CD pipeline that tests, builds, deploys, and monitors a containerized app.",
            "difficulty": "beginner"
          }
        ],
        "quiz": {
          "questionCount": 3,
          "topicsCovered": ["Observability", "Alerting", "Incident response"],
          "passingScore": 70
        },
        "milestone": "A deployed app with CI/CD, dashboards, and alerts you can explain."
